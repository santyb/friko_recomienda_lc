    {
      "parameters": {
        "jsCode": "\n// ══════════════════════════════════════════════════════════════════\n// Code: Build Flowise Query — v9.3 FIXED\n// Pasa msgText al RAG con sessionId y overrideConfig para que\n// Flowise Memory use el sessionId correcto del usuario en Upstash.\n// ══════════════════════════════════════════════════════════════════\nlet parseData = {};\ntry { parseData = $('Code: Parse Message').first()?.json ?? {}; } catch(e) {}\n\nconst chatId    = parseData.chatId    ?? 'unknown';\nconst firstName = parseData.firstName ?? 'amigo';\nconst msgText   = parseData.msgText   ?? '';\nconst sessionId = parseData.sessionId ?? ('tg_' + chatId);\n\nconst flowisePayload = {\n  question: msgText || 'Hola',\n  sessionId,\n  // overrideConfig garantiza que el nodo Memory en Flowise\n  // use ESTE sessionId como clave en Upstash Redis.\n  // Sin esto, si el campo sessionId del nodo Memory está vacío,\n  // Flowise puede generar claves aleatorias.\n  overrideConfig: {\n    sessionId,\n  },\n};\n\nreturn [{ json: { chatId, firstName, flowisePayload } }];\n"
      },
      "id": "52495994-92c3-4bcb-a310-4c079cba163f",
      "name": "Code: Build Flowise Query",
