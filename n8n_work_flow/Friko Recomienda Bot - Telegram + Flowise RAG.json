      "parameters": {
        "jsCode": "\n// ══════════════════════════════════════════════════════════════════\n// Code: Parse Message — v9.2\n// ══════════════════════════════════════════════════════════════════\nconst msg       = $input.first()?.json?.message ?? {};\nconst chatId    = msg?.chat?.id?.toString() ?? null;\nconst firstName = (msg?.from?.first_name ?? 'amigo').substring(0, 50);\nconst msgText   = (msg?.text ?? '').trim().substring(0, 2000);\nconst isText    = typeof msg?.text === 'string' && msg.text.trim().length > 0;\n\nconst RESET_CMDS = ['/start','/reset','/nuevo','/iniciar','/reiniciar'];\nconst isCommand  = RESET_CMDS.includes(msgText.toLowerCase());\n\n// sessionId estable por usuario — igual que usa Flowise\nconst sessionId = 'tg_' + chatId;\n\nreturn [{ json: { chatId, firstName, msgText, isText, isCommand, sessionId } }];\n"
      },
