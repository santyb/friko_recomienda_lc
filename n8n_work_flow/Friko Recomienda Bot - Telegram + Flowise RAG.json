        }
      },
      "id": "14ebc5af-cbad-4bd9-9390-d87814bfb861",
      "name": "HTTP: Call Flowise RAG",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        7280,
        6096
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst httpResp = $input.first()?.json ?? {};\n\nlet chatId = 'unknown', firstName = 'amigo';\ntry {\n  const bd = $('Code: Build Flowise Query').first()?.json ?? {};\n  if (bd.chatId && bd.chatId !== 'unknown') {\n    chatId    = bd.chatId;\n    firstName = bd.firstName ?? 'amigo';\n  }\n} catch(e) {}\n\nif (chatId === 'unknown') {\n  try {\n    const md = $('Code: Parse Message').first()?.json ?? {};\n    if (md.chatId) { chatId = md.chatId; firstName = md.firstName ?? 'amigo'; }\n  } catch(e) {}\n}\n\nconst rawText   = (httpResp?.text   ?? '').trim();\nconst rawAnswer = (httpResp?.answer ?? '').trim();\nconst isError   = !!(httpResp?.error)\n  || (typeof httpResp?.statusCode === 'number' && httpResp.statusCode >= 400)\n  || (!rawText && !rawAnswer);\n\nfunction mdToHtml(t) {\n  if (!t) return '';\n  return t\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\\*\\*\\*(.*?)\\*\\*\\*/gs, '<b><i>$1</i></b>')\n    .replace(/\\*\\*(.*?)\\*\\*/gs,     '<b>$1</b>')\n    .replace(/\\*(.*?)\\*/gs,          '<i>$1</i>')\n    .replace(/_(.*?)_/gs,            '<i>$1</i>')\n    .replace(/`([^`]+)`/g,           '<code>$1</code>')\n    .replace(/^#{1,3}\\s+(.+)$/gm,   '<b>$1</b>')\n    .replace(/\\[([^\\]]+)\\]\\([^)]+\\)/g, '$1')\n    .replace(/^---+$/gm,             '')\n    .replace(/^[\\-\\*]\\s+/gm,        '• ')\n    .replace(/\\n{3,}/g,             '\\n\\n')\n    .trim();\n}\n\nlet success = false, responseText = '';\n\nif (isError || chatId === 'unknown') {\n  responseText =\n    '⚠️ Tuve un inconveniente consultando el catálogo.\\n\\n' +\n    'Por favor intenta de nuevo escribiendo /nuevo.\\n' +\n    'Si el problema persiste, intenta más tarde.';\n} else {\n  success = true;\n  responseText =\n    mdToHtml(rawText || rawAnswer) +\n    '\\n\\n' +\n    '💬 ¿Quieres otra recomendación? Escribe /nuevo\\n' +\n    '🌐 www.momentosfriko.com';\n}\n\nreturn [{ json: { chatId, firstName, responseText, success } }];\n"
      },
